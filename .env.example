# This is an example of the .env file that you could create for easier 
# configuration of the app. It is not required to run the app. Create the
# .env file and export it if you want to configure the app this way.
# None of those variables are required, as the app will set the default
# values if they are not provided.

MQTT_SCHEME=transport_protocol_for_mqtt # default: "tcp"
MQTT_HOST=your_mqtt_host_address # default: "localhost"
MQTT_PORT=your_mqtt_port # default: "1883"
MQTT_TOPICS=your_topic_1:your_topic_2... # default: "insight-naturae/sensors"

DB_FILE=your_db_file_name.db # default: "./insight-naturae.db"

JWT_SECRET=your_jwt_secret_key # generated by the app if not provided